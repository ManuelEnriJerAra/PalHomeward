{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palworld Workshop Info.json",
  "type": "object",
  "required": ["ModName", "PackageName", "Version", "InstallRule"],
  "properties": {
    "ModName": { "type": "string", "minLength": 1 },
    "PackageName": { "$ref": "#/$defs/packageName" },
    "Thumbnail": { "type": "string" },
    "Version": { "type": "string" },
    "DebugMode": { "type": "boolean" },
    "MinRevision": { "type": "number" },
    "Author": { "type": "string" },
    "Dependencies": { "type": "array", "items": { "$ref": "#/$defs/packageName" } },
    "Tags": {
      "type": "array",
      "items": { "enum": ["PalSchema", "UE4SS", "Model Replacement", "Utilities", "Gameplay", "User Interface"] }
    },
    "InstallRule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Type", "Targets"],
        "properties": {
          "Type": { "enum": ["UE4SS", "Lua", "PalSchema", "LogicMods", "Paks"] },
          "Targets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "IsServer": { "type": "boolean" }
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "packageName": { "type": "string", "minLength": 1, "not": { "pattern": "[^A-Za-z0-9]" } }
  }
}
