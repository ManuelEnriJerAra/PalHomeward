{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PalHomeward ownership registry v1",
  "type": "object",
  "required": ["schemaVersion", "worldId", "revision"],
  "additionalProperties": false,
  "oneOf": [{ "required": ["pals"] }, { "required": ["pals_list"] }],
  "properties": {
    "schemaVersion": { "const": 1 },
    "worldId": { "$ref": "#/$defs/nonEmptyString" },
    "gameBuild": { "$ref": "#/$defs/nonEmptyString" },
    "revision": { "$ref": "#/$defs/revision" },
    "pals": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "$ref": "#/$defs/pal",
        "unevaluatedProperties": false
      }
    },
    "pals_list": {
      "description": "Alternate input form. The loader also checks uniqueness by palId.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pal",
        "required": ["palId"],
        "properties": { "palId": { "$ref": "#/$defs/nonEmptyString" } },
        "unevaluatedProperties": false
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "pal": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "ownerUid": { "anyOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
        "ownerEvidence": { "$ref": "#/$defs/nonEmptyString" },
        "ownerEvidenceRevision": { "$ref": "#/$defs/revision" },
        "status": { "enum": ["VERIFIED", "UNRESOLVED", "CONFLICT"] },
        "lastKnownBaseId": { "$ref": "#/$defs/nonEmptyString" },
        "lastKnownContainerId": { "$ref": "#/$defs/nonEmptyString" },
        "lastSeenOperationId": { "$ref": "#/$defs/nonEmptyString" }
      },
      "if": { "properties": { "status": { "const": "VERIFIED" } }, "required": ["status"] },
      "then": {
        "required": ["ownerUid", "ownerEvidence", "ownerEvidenceRevision"],
        "properties": { "ownerUid": { "$ref": "#/$defs/nonEmptyString" } }
      }
    }
  }
}
